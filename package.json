{
  "name": "@henrikogard/polvenn-mcp-server",
  "version": "0.1.1",
  "description": "MCP server for tracking beer releases on Vinmonopolet with an external release feed",
  "author": "Henrik",
  "type": "module",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henrikogaard/mcp-polvenn.git"
  },
  "homepage": "https://github.com/henrikogaard/mcp-polvenn#readme",
  "bugs": {
    "url": "https://github.com/henrikogaard/mcp-polvenn/issues"
  },
  "bin": {
    "polvenn-mcp-server": "dist/index.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "prepack": "npm run build",
    "test": "npm run build && node --test dist/**/*.test.js"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "vinmonopolet",
    "beer",
    "release-feed",
    "norway"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "sql.js": "^1.11.0",
    "cheerio": "^1.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
